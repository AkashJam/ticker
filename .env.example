# Copy to .env for local (non-devcontainer) development — the devcontainer
# and production compose both inject these as real environment variables
# instead. flags.LoadDotenv() no-ops silently if this file doesn't exist.

# sim | finnhub (finnhub is unimplemented in v1 — portfolio.md §16.1)
SOURCE=sim

# dev | prod — informational only, shapes log formatting
ENV=dev

# HTTP listen address
ADDR=:8080

# Finest candle interval: 10s locally, 1m in production (portfolio.md §15).
# The fixed 5m/15m/1h/1d set is always computed alongside this one.
AGG_WINDOW=10s

# debug | info | warn | error
LOG_LEVEL=info

# postgres://user:password@host:5432/dbname?sslmode=disable
TIMESCALE_DSN=postgres://ticker:ticker@localhost:5432/ticker?sslmode=disable

REDIS_ADDR=localhost:6379

# Optional — a healthchecks.io check URL for the ingestion loop's dead-man
# switch (§13). Leave empty to disable; nothing pings out if it's unset.
HEALTHCHECKS_URL=

# Finnhub API key (free tier). Required with SOURCE=finnhub and by the
# post-close daily-bar sweep (portfolio.md §15 Phase 8). Leave empty in dev
# and CI. In production it comes from SSM, never from a file.
FINNHUB_API_KEY=

# Optional — a second healthchecks.io check, for the daily-bar sweep only,
# separate from the ingest dead-man above. Empty disables the ping.
HEALTHCHECKS_SWEEP_URL=
